{
  "expo": {
    "name": "PDF Toolkit",
    "slug": "pdf-toolkit",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nourgad.pdftoolkit",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose photos to convert into a PDF.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Use the camera to scan documents into PDF."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pdf.toolkit",
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to convert into a PDF.",
          "cameraPermission": "Use the camera to scan documents into PDF.",
          "microphonePermission": false
        }
      ],
      "expo-dev-client",
      "./plugins/withLargeHeap",
      [
        "expo-media-library",
        {
          "photosPermission": "Save converted pages to your photos.",
          "savePhotosPermission": "Save converted pages to your photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ],
    "owner": "nourgad",
    "extra": {
      "eas": {
        "projectId": "c9d215ee-efb0-4fee-806c-b68eea182b58"
      }
    }
  }
}